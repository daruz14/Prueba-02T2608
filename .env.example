GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# "gemini" or "fake". "fake" needs no key: use it for tests and CI.
MODEL_BACKEND=fake
TZ=America/Santiago
PORT=8080
# Optional. When set, every request except GET /health must carry it as
# `x-api-key: <key>` or `Authorization: Bearer <key>` (min 8 chars).
# Leave empty for local development.
INGRESS_API_KEY=
# Eval runner options (not used by the app):
EVAL_CASE=valid_slot
EVAL_MAX_REQUESTS=4
